# Server Environment Variables
# Copy this file to `.env` and fill in your actual values

# Application
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/find_event_platform

# JWT Secrets
JWT_ACCESS_SECRET=dev_access_secret_change_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ImageKit (Image Upload Service)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Email (Brevo SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_email
BREVO_SMTP_PASS=your_brevo_api_key
MAIL_FROM=noreply@findevent.app

# PayPal - Sandbox (Testing)
PAYPAL_CLIENT_ID=AZR_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal - Live (Production - uncomment when ready)
# PAYPAL_CLIENT_ID=AZR_live_client_id_here
# PAYPAL_CLIENT_SECRET=your_live_secret_here
# PAYPAL_BASE_URL=https://api-m.paypal.com

# Frontend URLs
CLIENT_URL=http://localhost:5173
